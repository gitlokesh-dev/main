:root{
  --brand    :rgb(216,0,116);
  --brand-dk :rgb(175,0,93);
  --brand-lt :rgba(216,0,116,.10);
  --brand-xlt:rgba(216,0,116,.05);
  --brand-bd :rgba(216,0,116,.28);
  --white    :#fff;
  --bg       :#f2f4f8;
  --bg2      :#f9fafb;
  --border   :#e0e4ea;
  --border-lt:#edf0f4;
  --text     :#1a1d23;
  --text-s   :#4b5563;
  --text-m   :#9ca3af;
  --green    :#059669;
  --amber    :#d97706;
  --blue     :#2563eb;
  --red      :#dc2626;
